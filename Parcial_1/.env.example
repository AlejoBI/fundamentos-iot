# ─── MySQL ─────────────────────────────
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=iot_db
MYSQL_USER=iot_user
MYSQL_PASSWORD=change_this_mysql_password

# ─── MQTT (Maqiatto) ───────────────────
MQTT_SERVER=maqiatto.com
MQTT_PORT=1883
MQTT_USER=your_email@domain.com
MQTT_PASS=change_this_mqtt_password
TOPICO_COMANDOS=your_email@domain.com/comandos
TOPICO_DATOS=your_email@domain.com/alertas

# ─── Umbrales (ESP32 + Simulador + Node-RED) ───
UMBRAL_TEMP=28.0
UMBRAL_GAS=3600

# ─── Intervalos por estado (segundos) ───
INTERVALO_NORMAL_SEG=10
INTERVALO_ALERTA_SEG=6
INTERVALO_EMERGENCIA_SEG=3

# ─── IDs de dispositivos y zonas ───────
DEVICE_ID_ESP32=ESP32-Cocina-01
ZONA_ESP32=Cocina-Principal
DEVICE_ID_SIM=SIM-Cocina
ZONA_SIM=Cocina-Simulada

# ─── Rangos del simulador ──────────────
SIM_TEMP_MIN=20
SIM_TEMP_MAX=35
SIM_MQ135_MIN=100
SIM_MQ135_MAX=3500

# ─── Calidad de datos (solo simulador) ─
SIM_MISSING_PROB=0.005
SIM_OUTLIER_PROB=0.005
SIM_DUP_PROB=0.02
SIM_GAP_PROB=0.01
SIM_GAP_SECONDS=35
